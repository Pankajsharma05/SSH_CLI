{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SSH_CLI",
  "version": "1.0.0",
  "identifier": "io.github.pankajsharma05.ssh-cli",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "SSH_CLI",
        "width": 1360,
        "height": 880,
        "minWidth": 940,
        "minHeight": 620,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/32x32.png",
      "icons/icon.png"
    ]
  }
}
